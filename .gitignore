# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# intermediate sertifikat za APR, mora u repo (vidi scripts/certs/README.md)
!scripts/certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# privremeni uzorci, ne komituju se
uzorak-imena.md
fallback-lista.md
kolizije.md
fallback-491.md
scripts/tmp-probe.ts

# runtime stanje NBS obogaćivanja (enrich-pib-blokade.ts)
scripts/data/nbs-zavrseno.json
scripts/data/nbs-blokade.json

# runtime stanje NBS obogaćivanja (enrich-pib-rir.ts)
scripts/data/nbs-rir-zavrseno.json

# runtime stanje NBS/CRP obogaćivanja (enrich-zabrane.ts)
scripts/data/nbs-zabrane-zavrseno.json
scripts/data/nbs-zabrane-dopuna-zavrseno.json
scripts/data/nbs-zabrane-aktivne-zavrseno.json

# runtime stanje NBS obogaćivanja (enrich-pib-rir.ts --adresa)
scripts/data/nbs-rir-adresa-zavrseno.json
